{
  "name": "meshline",
  "version": "0.8.16",
  "private": true,
  "main": "desktop.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node server.cjs",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test bluetooth.test.cjs radio.test.cjs routes.test.cjs recovery.test.cjs delivery.test.cjs attention.test.cjs search.test.cjs backup.test.cjs updates.test.cjs health.test.cjs drafts.test.cjs backup-reminders.test.cjs radio-tools.test.cjs serial.test.cjs tray.test.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.meshline.desktop",
    "productName": "Nightlink",
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "desktop.cjs",
      "preload.cjs",
      "bluetooth.js",
      "bluetooth-ui.js",
      "radio.js",
      "live-ui.js",
      "icon.svg",
      "icon.ico",
      "routes.js",
      "contacts-ui.js",
      "dm-ui.js",
      "dm.html",
      "dm.js",
      "dm-preload.cjs",
      "dm.wav",
      "glass.css",
      "design-ui.js",
      "recovery.js",
      "recovery-ui.js",
      "route-map.js",
      "vendor/leaflet.js",
      "vendor/leaflet.css",
      "vendor/LEAFLET-LICENSE",
      "street-maps.js",
      "overview-ui.js",
      "delivery.js",
      "delivery-ui.js",
      "mentions-ui.js",
      "dm-inbox.js",
      "readability.css",
      "readability-ui.js",
      "connection-window.js",
      "connection-window.css",
      "attention.js",
      "attention-ui.js",
      "attention.css",
      "search.js",
      "search-ui.js",
      "search.css",
      "backup.js",
      "backup-ui.js",
      "backup.css",
      "updates.cjs",
      "updates-ui.js",
      "updates.css",
      "health.js",
      "health-ui.js",
      "drafts.js",
      "drafts-ui.js",
      "backup-reminders.js",
      "backup-reminders-ui.js",
      "navigation-ui.js",
      "window-fit.css",
      "radio-tools.js",
      "radio-tools-ui.js",
      "radio-tools.css",
      "vendor/qrcode.js",
      "vendor/jsQR.js",
      "vendor/QRCODE-LICENSE",
      "vendor/JSQR-LICENSE",
      "vendor/QR-SOURCES.md",
      "corescope-ui.js",
      "corescope.css",
      "serial.js",
      "transport.js",
      "serial-ui.js",
      "serial.css",
      "serial-desktop.cjs",
      "desktop-shell.cjs",
      "tray-policy.js",
      "tray-ui.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Nightlink",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nightlink-Setup-${version}.${ext}",
      "include": "installer.nsh",
      "installerHeader": "installer-assets/header.bmp",
      "installerSidebar": "installer-assets/sidebar.bmp",
      "uninstallerSidebar": "installer-assets/sidebar.bmp"
    },
    "portable": {
      "artifactName": "Nightlink-Portable-${version}.${ext}"
    }
  },
  "description": "Nightlink — a Bluetooth and USB MeshCore desktop client",
  "author": "Nightlink"
}
