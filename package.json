    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Nightlink",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nightlink-Setup-${version}.${ext}",
      "include": "installer.nsh",
      "installerHeader": "installer-assets/header.bmp",
      "installerSidebar": "installer-assets/sidebar.bmp",
      "uninstallerSidebar": "installer-assets/sidebar.bmp",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "Nightlink-Portable-${version}.${ext}"
    }
  },
  "description": "Nightlink \u2014 a Bluetooth and USB MeshCore desktop client",
  "author": "Nightlink"
