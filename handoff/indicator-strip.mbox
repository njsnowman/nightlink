diff --git a/indicator-strip.css b/indicator-strip.css
new file mode 100644
index 0000000..52c75da
--- /dev/null
+++ b/indicator-strip.css
@@ -0,0 +1,33 @@
+/* Feature indicator strip: one uniform chip per feature status, in the page heading. */
+:root{--indicator-ok:#7be0b3;--indicator-info:#8fc7ff;--indicator-warn:#f0b44c;--indicator-alert:#ff858f}
+.page-heading{display:flex;align-items:center;gap:16px}
+.page-heading>div:first-child{flex:0 1 auto;min-width:0}
+.indicator-strip{display:flex;flex:1 1 0;flex-wrap:nowrap;overflow:hidden;padding:3px;justify-content:flex-end;align-items:center;gap:8px;min-width:0}
+.indicator-strip[hidden]{display:none}
+.indicator-chip{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 12px;border:1px solid var(--nl-edge,#303030);border-radius:var(--nl-radius-control,9px);background:var(--nl-surface,#080808);color:var(--nl-copy,#eeeeef);font-family:inherit;font-size:12px;font-weight:500;line-height:1;white-space:nowrap;cursor:pointer;max-width:100%}
+.indicator-chip[hidden]{display:none!important}
+.indicator-chip:hover{background:var(--nl-hover)}
+.indicator-chip:focus-visible{outline:2px solid var(--nl-accent,#ffbf56);outline-offset:2px}
+.indicator-chip svg{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
+.indicator-chip-label{overflow:hidden;text-overflow:ellipsis}
+.indicator-chip-feature{color:var(--nl-muted,#b9b9bf)}
+.indicator-chip-sep{color:var(--nl-muted,#b9b9bf)}
+.indicator-chip[data-tone=off]{opacity:.65}
+.indicator-chip[data-tone=ok] svg{color:var(--indicator-ok)}
+.indicator-chip[data-tone=info] svg{color:var(--indicator-info)}
+.indicator-chip[data-tone=warn]{color:var(--indicator-warn);border-color:color-mix(in srgb,var(--indicator-warn) 55%,transparent);background:color-mix(in srgb,var(--indicator-warn) 10%,var(--nl-surface,#080808))}
+.indicator-chip[data-tone=alert]{color:var(--indicator-alert);border-color:color-mix(in srgb,var(--indicator-alert) 60%,transparent);background:color-mix(in srgb,var(--indicator-alert) 12%,var(--nl-surface,#080808))}
+.indicator-chip:is([data-tone=warn],[data-tone=alert]) .indicator-chip-feature,.indicator-chip:is([data-tone=warn],[data-tone=alert]) .indicator-chip-sep{color:inherit;opacity:.8}
