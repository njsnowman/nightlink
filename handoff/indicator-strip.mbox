-.propagation-indicator[data-level=insufficient-data]{color:var(--nl-muted,#b9b9bf)}
-.propagation-indicator[data-level=possible-opening]{color:var(--propagation-amber);border-color:color-mix(in srgb,var(--propagation-amber) 55%,transparent)!important;background:color-mix(in srgb,var(--propagation-amber) 10%,transparent)!important}
-.propagation-indicator[data-level=strong-anomaly]{color:var(--propagation-red);border-color:color-mix(in srgb,var(--propagation-red) 60%,transparent)!important;background:color-mix(in srgb,var(--propagation-red) 12%,transparent)!important}
+.propagation-live{position:fixed;top:0;left:0;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
 .propagation-indicator.propagation-animate[data-level=possible-opening] svg{animation:propagation-pulse 2.4s ease-in-out infinite}
 .propagation-indicator.propagation-animate.propagation-flash[data-level=strong-anomaly]{animation:propagation-flash .6s ease-in-out 3}
 @keyframes propagation-pulse{0%,100%{opacity:1}50%{opacity:.45}}
